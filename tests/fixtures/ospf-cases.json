{
  "_source": "Copied by hand from StarterKit/SPEC.md, 'Cases the implementation must satisfy'. Never generated by the engine. Changing an expected value needs the owner.",
  "topologies": {
    "T1": {
      "routers": { "A": 1, "B": 2, "C": 3, "D": 4, "E": 5 },
      "links": [["A", "B", 10], ["B", "C", 10], ["A", "D", 10], ["D", "C", 10], ["A", "C", 25], ["C", "E", 5]]
    },
    "T2": {
      "routers": { "S": 1, "A": 2, "B": 3, "C": 4, "D": 5, "T": 6 },
      "links": [["S", "A", 1], ["S", "B", 1], ["A", "T", 2], ["B", "C", 1], ["B", "D", 1], ["C", "T", 1], ["D", "T", 1]]
    }
  },
  "cases": [
    { "id": 1, "name": "Lowest cost, with a tie", "topology": "T1", "sharing": true,
      "expect": [{ "from": "A", "to": "C", "cost": 20, "nextHops": ["B", "D"] }] },
    { "id": 2, "name": "Path through a transit router", "topology": "T1", "sharing": true,
      "expect": [{ "from": "A", "to": "E", "cost": 25, "nextHops": ["B", "D"] }] },
    { "id": 3, "name": "Boundary: equal to the tie", "topology": "T1", "sharing": true, "setCost": [["A", "C", 20]],
      "expect": [{ "from": "A", "to": "C", "cost": 20, "nextHops": ["B", "C", "D"] }] },
    { "id": 4, "name": "Boundary: one below", "topology": "T1", "sharing": true, "setCost": [["A", "C", 19]],
      "expect": [{ "from": "A", "to": "C", "cost": 19, "nextHops": ["C"] }, { "from": "A", "to": "E", "cost": 24, "nextHops": ["C"] }] },
    { "id": 5, "name": "Reconvergence after a cut", "topology": "T1", "sharing": true, "cut": [["B", "C"]],
      "expect": [{ "from": "A", "to": "C", "cost": 20, "nextHops": ["D"] }, { "from": "B", "to": "C", "cost": 30, "nextHops": ["A"] },
                 { "from": "B", "to": "E", "cost": 35, "nextHops": ["A"] }] },
    { "id": 6, "name": "One route kept", "topology": "T1", "sharing": false,
      "expect": [{ "from": "A", "to": "C", "cost": 20, "nextHops": ["B"] }] },
    { "id": 7, "name": "Split is per hop, not per path", "topology": "T2", "sharing": true,
      "expect": [{ "from": "S", "to": "T", "cost": 3, "nextHops": ["A", "B"] }],
      "shares": { "from": "S", "to": "T", "packets": 400,
        "links": { "S-A": 200, "A-T": 200, "S-B": 200, "B-C": 100, "B-D": 100, "C-T": 100, "D-T": 100 } } },
    { "id": 8, "name": "No path", "topology": "T1", "sharing": true, "cut": [["C", "E"]],
      "expect": [{ "from": "A", "to": "E", "unreachable": true }, { "from": "E", "to": "A", "unreachable": true },
                 { "from": "E", "to": "C", "unreachable": true }, { "from": "A", "to": "C", "cost": 20, "nextHops": ["B", "D"] }] }
  ],
  "overload": { "id": 9, "capacityPerSec": 4, "queueLen": 8, "offeredPerSec": 6, "seconds": 10,
    "expect": { "offered": 60, "served": 40, "queued": 8, "dropped": 12 } },
  "invalidCosts": { "id": 10, "values": [0, 65536, -1, 1.5], "valid": [1, 65535] },
  "score": { "id": 11, "delivered": 1840, "dropped": 212, "seconds": 365, "expect": { "score": 1840, "time": "6:05" } }
}
